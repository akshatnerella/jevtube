{
  "manifest_version": 3,
  "name": "SloppyYT: Spot Slop & Clickbait on YouTube",
  "short_name": "SloppyYT",
  "version": "1.3.0",
  "description": "Color-codes every YouTube video as slop, clickbait, news or your own categories, so you know what it is before you click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://jev-backend.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "settings.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SloppyYT",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "homepage_url": "https://github.com/akshatnerella/jevtube",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-sloppy": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Turn SloppyYT on or off"
    }
  }
}
