{
  "manifest_version": 3,
  "name": "SloppyYT",
  "version": "0.1.0",
  "description": "Real-time YouTube feed sorting with Jev: boxes every video as slop, clickbait, news, ads and more.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["categories.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "SloppyYT" }
}
